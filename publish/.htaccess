RewriteEngine On

RewriteCond %{HTTP_HOST} ^(setn\.shop|www\.setn\.shop|seetona\.com)$ [NC]
RewriteRule ^ https://www.seetona.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.seetona\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.seetona.com%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_URI} ^/app\.xcg$ [NC]
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^app\.xcg$ /index.html [R=302,L]

# Pretty per-game URLs (e.g. /minesweeper/, /binary/) load the SPA shell.
RewriteRule ^(minesweeper|binary|planet|management|fishing|solitaire)/?$ /index.html [L]

DirectoryIndex index.html app.xcg

<IfModule mod_headers.c>
  Header always setifempty Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'sha256-tgYHzF47b8yBol70Z4bTIkDVsojhKxUq+nAFxrsdY/Q='; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"
  Header always setifempty X-Content-Type-Options "nosniff"
  Header always setifempty X-Frame-Options "SAMEORIGIN"
  Header always setifempty Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), autoplay=()"
</IfModule>

<FilesMatch "^(README\.md|Dockerfile|app\.py|app_core\.py|minesweeper\.py|__init__\.py)$">
  Require all denied
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

RedirectMatch 404 ^/tests/
RedirectMatch 404 ^/__pycache__/
RedirectMatch 404 ^/runtime/
